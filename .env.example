# GitHub (optional but recommended — anonymous rate limits are low)
GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com

# Model provider: gemini | openai-oauth
MODEL_PROVIDER=openai-oauth

# --- gemini (Antigravity default Gemini backend) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=

# --- openai-oauth (bunx openai-oauth local proxy) ---
# 1) bunx openai-oauth login
# 2) bunx openai-oauth --detach
# 3) set MODEL_PROVIDER=openai-oauth
OPENAI_BASE_URL=http://127.0.0.1:10531/v1
OPENAI_MODEL=gpt-5.6-terra
# Dummy key — required by some OpenAI clients; the local proxy ignores it
OPENAI_API_KEY=sk-local

# SEARCH_RESULT_LIMIT=20
